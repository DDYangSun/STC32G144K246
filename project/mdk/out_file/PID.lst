   11          void PID_Init(PID_t *p)
   12          {
   13   1        /*把PID表示状态的参数清零，避免之前遗留的参数对本次启动造成影响*/
   14   1        p->Target = 0;
   15   1        p->Actual = 0;
   16   1        p->Out = 0;
   17   1        p->Error0 = 0;
   18   1        p->Error1 = 0;
   19   1        p->ErrorInt = 0;
   20   1      }
