   27          void PID_Update(PID_t *p)
   28          {
   29   1        /*获取本次误差和上次误差*/
   30   1        p->Error1 = p->Error0;          //获取上次误差
   31   1        p->Error0 = p->Target - p->Actual;    //获取本次误差，目标值减实际值，即为误差值
   32   1        
   33   1        /*外环误差积分（累加）*/
   34   1        /*如果Ki不为0，才进行误差积分，这样做的目的是便于调试*/
   35   1        /*因为在调试时，我们可能先把Ki设置为0，这时积分项无作用，误差消除不了，误差积分会积累到很大的值*/
   36   1        /*后续一旦Ki不为0，那么因为误差积分已经积累到很大的值了，这就导致积分项疯狂输出，不利于调试*/
   37   1        if (p->Ki != 0)       //如果Ki不为0
   38   1        {
   39   2          p->ErrorInt += p->Error0; //进行误差积分
   40   2        }
   41   1        else              //否则
   42   1        {
   43   2          p->ErrorInt = 0;      //误差积分直接归0
   44   2        }
   45   1        
   46   1        /*PID计算*/
   47   1        /*使用位置式PID公式，计算得到输出值*/
   48   1        p->Out = p->Kp * p->Error0
   49   1             + p->Ki * p->ErrorInt
   50   1             + p->Kd * (p->Error0 - p->Error1);
   51   1        
   52   1        /*输出限幅*/
   53   1        if (p->Out > p->OutMax) {p->Out = p->OutMax;} //限制输出值最大为结构体指定的OutMax
   54   1        if (p->Out < p->OutMin) {p->Out = p->OutMin;} //限制输出值最小为结构体指定的OutMin
   55   1      }
