   34   1      
   35   1        /*如果Ki不为0，才进行误差积分，这样做的目的是便于调试*/
   36   1        /*因为在调试时，我们可能先把Ki设置为0，这时积分项无作用，误差消除不了，误差积分会积累到很大的值*/
   37   1        /*后续一旦Ki不为0，那么因为误差积分已经积累到很大的值了，这就导致积分项疯狂输出，不利于调试*/
   38   1        if (p->Ki != 0)       //如果Ki不为0
   39   1        {
   40   2          p->ErrorInt += p->Error0; //进行误差积分
   41   2        }
   42   1        else              //否则
   43   1        {
   44   2          p->ErrorInt = 0;      //误差积分直接归0
   45   2        }
   46   1        
   47   1        /*PID计算*/
   48   1        /*使用位置式PID公式，计算得到输出值*/
   49   1        p->Out = p->Kp * p->Error0
