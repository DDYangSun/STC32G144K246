   22          /**
   23            * 函    数：PID计算及结构体变量值更新
   24            * 参    数：p 指定结构体的地址
   25            * 返 回 值：无
   26            */
   27          void PID_Update(PID_t *p)
   28          {
   29   1        /*获取本次误差和上次误差*/
   30   1        p->Error1 = p->Error0;          //获取上次误差
   31   1        p->Error0 = p->Target - p->Actual;    //获取本次误差，目标值减实际值，即为误差值
   32   1        
   33   1        /*外环误差积分（累加）*/
   34   1      
   35   1        /*如果Ki不为0，才进行误差积分，这样做的目的是便于调试*/
   36   1        /*因为在调试时，我们可能先把Ki设置为0，这时积分项无作用，误差消除不了，误差积分会积累到很大的值*/
   37   1        /*后续一旦Ki不为0，那么因为误差积分已经积累到很大的值了，这就导致积分项疯狂输出，不利于调试*/
   38   1        if (p->Ki != 0)       //如果Ki不为0
   39   1        {
   40   2          p->ErrorInt += p->Error0; //进行误差积分
   41   2        }
   42   1        else              //否则
   43   1        {
   44   2          p->ErrorInt = 0;      //误差积分直接归0
   45   2        }
   46   1        
   47   1        /*PID计算*/
   48   1        /*使用位置式PID公式，计算得到输出值*/
   49   1        p->Out = p->Kp * p->Error0
   50   1             + p->Ki * p->ErrorInt
   51   1             + p->Kd * (p->Error0 - p->Error1);
   52   1        
   53   1        /*输出限幅*/
   54   1        if (p->Out > p->OutMax) {p->Out = p->OutMax;} //限制输出值最大为结构体指定的OutMax
   55   1        if (p->Out < p->OutMin) {p->Out = p->OutMin;} //限制输出值最小为结构体指定的OutMin
   56   1      }
