   26          uint8 Otsu_GetThreshold(uint16 *GrayImage,uint16 PixelNum)       //灰度直方图
   27          {
   28   1        uint8 Otsu_Threshold = 0;
   29   1        uint32 Threshold_BackgroundNum = 0,Thereshold_ForegroundNum = 0;        //前景背景的像素数量
   30   1        uint32 Threshold_BackgroundSum = 0,Threshold_ForegroundSum = 0;   //灰度值
   31   1        int32 w0,w1,u0,u1;
   32   1        int32 Variance = 0,Variance_Temp = 0;           //方差
   33   1      
   34   1        uint16 i,j;
   35   1      
   36   1        for (i = 1;i < 255;i++)
   37   1        {
   38   2          for (j = 0;j < 256;j++)
   39   2          {
   40   3            if (j < i)
   41   3            {
   42   4              Threshold_BackgroundNum += GrayImage[j];      //计算背景灰度值数量之和，用于计算背景权重
   43   4              Threshold_BackgroundSum += GrayImage[j] * j;
   44   4            }
   45   3            else
   46   3            {
   47   4              Thereshold_ForegroundNum += GrayImage[j];     //计算前景灰度值数量之和，用于计算前景权重        
   48   4              Threshold_ForegroundSum += GrayImage[j] * j;
   49   4            }
   50   3      
   51   3          }
   52   2          w0 = (Threshold_BackgroundNum * 100) / PixelNum;
   53   2          w1 = 100 - w0;  
   54   2      
   55   2          u0 = Threshold_BackgroundSum / Threshold_BackgroundNum;
   56   2          u1 = Threshold_ForegroundSum / Thereshold_ForegroundNum;
C251 COMPILER V5.60.0,  Binaryzation                                                       08/11/26  23:11:10  PAGE 2   

   57   2      
   58   2          Variance_Temp = w0 * w1 * (u0 - u1) * (u0 - u1);
   59   2      
   60   2          if (Variance_Temp > Variance)
   61   2          {
   62   3            Otsu_Threshold = i;
   63   3                  
   64   3            Variance = Variance_Temp;
   65   3          }
   66   2      
   67   2          Threshold_BackgroundNum = Thereshold_ForegroundNum = Threshold_BackgroundSum = Threshold_ForegroundSum 
             -= 0;
   68   2        }
   69   1      
   70   1          tft180_show_uint8(0,70,Otsu_Threshold);
   71   1        return Otsu_Threshold;
   72   1      }
