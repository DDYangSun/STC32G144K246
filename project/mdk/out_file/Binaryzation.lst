    4          //制作像素值数量图表
    5          void DrawPixelChart(uint8 *GrayImage,uint16 Length,uint16 *PixelValueNum)
    6          {
    7   1        uint16 i;
    8   1      
    9   1        for(i = 0;i < 256;i++)    //每帧统计前必须先清零，否则直方图会一帧帧累加，uint16 几帧就溢出
   10   1        {
   11   2          PixelValueNum[i] = 0;
   12   2        }
   13   1      
   14   1        for(i = 0;i < Length;i++)
   15   1        {
   16   2          PixelValueNum[*GrayImage]++;
   17   2          GrayImage++;
   18   2        }
   19   1      }
